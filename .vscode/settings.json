{
  // Editor settings
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "never",
    "source.organizeImports": "explicit"
  },
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,
  // TypeScript settings
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  // Oxc settings
  "oxc.fmt.configPath": ".oxfmtrc.json",
  // Testing settings
  "testExplorer.useNativeTesting": false,
  // File associations
  "files.associations": {
    "*.md": "markdown",
    "vitest.config.ts": "typescript"
  },
  // Exclude files from search and explorer
  "files.exclude": {
    "**/node_modules": true,
    "**/build": true,
    "**/.git": true,
    "**/.DS_Store": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/build": true,
    "**/*.log": true
  },
  // Git settings
  "git.autofetch": true,
  "git.enableSmartCommit": true,
  "js/ts.tsdk.path": "node_modules/typescript/lib",
}