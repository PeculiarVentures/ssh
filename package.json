{
  "name": "@peculiar/ssh",
  "version": "1.1.3",
  "description": "A TypeScript library for working with SSH keys and certificates in both Node.js and browsers, built on top of WebCrypto. Provides parsing, serialization, conversion (SPKI/PKCS8 ↔ SSH), and certificate signing/verification with an extensible algorithm registry.",
  "keywords": [
    "ssh",
    "crypto",
    "webcrypto",
    "keys",
    "certificates",
    "ed25519",
    "rsa",
    "ecdsa",
    "pkcs8",
    "spki",
    "typescript"
  ],
  "author": "Peculiar Ventures LLC",
  "contributors": [
    "Miroshin Stepan <microshine@mail.ru>"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/PeculiarVentures/ssh"
  },
  "bugs": {
    "url": "https://github.com/PeculiarVentures/ssh/issues"
  },
  "homepage": "https://github.com/PeculiarVentures/ssh#readme",
  "main": "./build/index.js",
  "module": "./build/index.mjs",
  "types": "./build/index.d.ts",
  "sideEffects": true,
  "exports": {
    ".": {
      "import": "./build/index.mjs",
      "require": "./build/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^5.0.3",
    "conventional-changelog": "^8.1.3",
    "conventional-changelog-angular": "^9.4.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@peculiar/utils": "^3.0.0"
  }
}
